{
  "mcpServers": {
    "rag-lab": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "company"
      }
    },
    "cv-desk": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "cvs"
      }
    }
  }
}
